# Postgres connection string for the grepless_app role (Supabase transaction pooler, port 6543)
DATABASE_URL=postgresql://grepless_app.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Optional: enables the one-line "Explain" button. Either a free Groq key…
GROQ_API_KEY=
# …or Vercel AI Gateway (OIDC on Vercel; needs AI Gateway credits unlocked on the account)
EXPLAIN_ENABLED=false
EXPLAIN_MODEL=openai/gpt-4.1-nano

# Optional: GitHub token (public-repo read only) to fetch repo description/stars without rate limits
GITHUB_TOKEN=
