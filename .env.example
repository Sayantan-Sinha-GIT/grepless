# Postgres connection string for the grepless_app role (Supabase transaction pooler, port 6543)
DATABASE_URL=postgresql://grepless_app.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Optional: enables the one-line "Explain" button. Providers are tried in order:
# Gemini (Google AI Studio free tier) → Groq (free tier) → Vercel AI Gateway.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# Vercel AI Gateway (OIDC on Vercel; needs AI Gateway credits unlocked on the account)
EXPLAIN_ENABLED=false
EXPLAIN_MODEL=openai/gpt-4.1-nano

# Optional: GitHub token (public-repo read only) to fetch repo description/stars without rate limits
GITHUB_TOKEN=

# Sign in with GitHub (private repos). Created by `node scripts/create-github-app.mjs`.
# Sign-in stays hidden until all of these are set.
GITHUB_APP_SLUG=
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 32+ random characters; encrypts GitHub tokens at rest. Changing it signs everyone out.
AUTH_SECRET=
